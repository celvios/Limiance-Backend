APP_ENV=development
HTTP_ADDRESS=:8080
SESSION_TTL=24h
# New withdrawal addresses cannot be used until this security cooldown expires.
WITHDRAWAL_ADDRESS_COOLDOWN=24h
# At least 32 characters; use a distinct secret in every environment.
VERIFICATION_CODE_PEPPER=
# Base64-encoded 32-byte key; encrypts short-lived OTPs in outbox events.
VERIFICATION_ENCRYPTION_KEY=
TRAVEL_RULE_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY=
BYBIT_MARKET_DATA_BASE_URL=https://api.bybit.com
COINBASE_MARKET_DATA_BASE_URL=https://api.exchange.coinbase.com
KRAKEN_MARKET_DATA_BASE_URL=https://api.kraken.com
# ZeroMQ endpoints owned by the separate matching engine process.
MATCHING_ENGINE_ORDER_ENDPOINT=tcp://127.0.0.1:5555
MATCHING_ENGINE_CONTROL_ENDPOINT=tcp://127.0.0.1:5556
MATCHING_ENGINE_EVENT_ENDPOINT=tcp://127.0.0.1:5557
MATCHING_ENGINE_REQUEST_TIMEOUT=250ms
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
LOG_LEVEL=info
DATABASE_URL=postgres://limiance:development-only@localhost:15432/limiance?sslmode=disable
REDIS_URL=redis://localhost:6380/0
AWS_REGION=eu-central-1
# Local SQS emulator values; production uses the AWS queue URL and no endpoint override.
SQS_OUTBOX_QUEUE_URL=
SQS_NOTIFICATIONS_QUEUE_URL=
SQS_DEPOSITS_QUEUE_URL=
SQS_UNROUTED_QUEUE_URL=
SQS_ENDPOINT=
FIREBLOCKS_API_KEY=
# PEM-encoded RSA private key. For this local .env put the PEM on ONE line and
# replace each line break with the two characters \n. In production inject the
# normal multiline PEM from AWS Secrets Manager; never commit or expose it.
FIREBLOCKS_PRIVATE_KEY=
# Testnet/mainnet API base URL depends on your Fireblocks workspace region:
# US: https://api.fireblocks.io; EU: https://eu-api.fireblocks.io;
# EU2: https://eu2-api.fireblocks.io; Sandbox only: https://sandbox-api.fireblocks.io
FIREBLOCKS_BASE_URL=

# Self-custody remains disabled until the isolated hardware-backed signer is
# provisioned and audited. It can only be enabled for Bitcoin testnet and
# Ethereum Sepolia; no mainnet route is accepted by this mode.
CUSTODY_MODE=fireblocks
SELF_CUSTODY_TESTNET_ENABLED=false
SELF_CUSTODY_SIGNER_URL=
SELF_CUSTODY_KMS_KEY_ID=
# Choose the V2 Webhook JWKS for the same region as FIREBLOCKS_BASE_URL.
FIREBLOCKS_JWKS_URL=https://eu-keys.fireblocks.io/.well-known/jwks.json
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=
SUMSUB_WEBHOOK_SECRET=
FIREBLOCKS_WEBHOOK_SECRET=
YELLOW_CARD_API_KEY=
CNGN_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=
# Opt-in local Twilio sandbox test only; do not commit a real number.
TWILIO_TEST_RECIPIENT=
TWILIO_TEST_CODE=
SENDGRID_API_KEY=
# Must be a verified Single Sender or authenticated domain address in SendGrid.
SENDGRID_FROM_EMAIL=
# Optional: current verification emails are composed by the backend.
SENDGRID_VERIFICATION_TEMPLATE_ID=
